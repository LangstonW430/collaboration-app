# Written automatically by `npx convex dev` — do not commit .env.local
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# SITE_URL, JWT_PRIVATE_KEY and JWKS are NOT set here. They live on the Convex
# deployment itself — set them with `npx @convex-dev/auth`. See README step 3.

# Sentry error tracking (optional — logging/monitoring works without these)
# Get DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Required only for source-map uploads in CI/CD:
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
